# VoltScope Environment Configuration Template
# Copy this file to .env and customize for your local setup

# Flask App Settings
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=0
PORT=5000
SECRET_KEY=voltscope-insecure-dev-secret-key-change-me-for-production

# Tableau Integration (Embedding API v3)
# When left empty, the application renders a high-fidelity local interactive preview
TABLEAU_DASHBOARD_URL=
TABLEAU_STORY_URL=

# Database Settings
DATABASE_PATH=database/voltscope.db
